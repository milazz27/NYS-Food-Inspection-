create function distance(lat1 float, lon1 float, lat2 float, lon2 float)
       returns float as $$
declare
    earth_radius float = 3963.19;
    a float;
    c float;
    d float;
    change_lat float;
    change_long float;
begin
    lat1 = radians(lat1);
    lon1 = radians(lon1);
    lat2 = radians(lat2);
    lon2 = radians(lon2);

    change_lat = lat2 - lat1;
    change_long = lon2 - lon1;
    a = sin(change_lat/2)*sin(change_lat/2) + 
        cos(lat1)*cos(lat2)*sin(change_long/2)*
        sin(change_long/2);
    c = 2*atan(SQRT(a), SQRT(1-a));
    d = earth_radius * c;

    return d ;
end ;
$$ language plpgsql ;
 select distance(40.70,-74.01,42.73,-73.68);
drop function distance;
create function distance(lat1 float, lon1 float, lat2 float, lon2 float)
       returns float as $$
declare
    earth_radius float = 3963.19;
    a float;
    c float;
    d float;
    change_lat float;
    change_long float;
begin
    lat1 = radians(lat1);
    lon1 = radians(lon1);
    lat2 = radians(lat2);
    lon2 = radians(lon2);

    change_lat = lat2 - lat1;
    change_long = lon2 - lon1;
    a = sin(change_lat/2)*sin(change_lat/2) + 
        cos(lat1)*cos(lat2)*sin(change_long/2)*
        sin(change_long/2);
    c = 2*atan2(SQRT(a), SQRT(1-a));
    d = earth_radius * c;

    return d ;
end ;
$$ language plpgsql ;
