CREATE FUNCTION a_trg1 () RETURNS trigger AS $$
	BEGIN
	   IF NEW.id < 4 THEN
		NEW.name = upper(NEW.name);
		DELETE FROM b WHERE id = NEW.id;
	END IF ;
	   RETURN NEW ;
	END;
$$ LANGUAGE plpgsql;
CREATE TRIGGER a_trg1 BEFORE INSERT ON a
	FOR EACH ROW EXECUTE FUNCTION a_trg1();
CREATE FUNCTION b_trg1 () RETURNS trigger AS $$
	BEGIN
	   NEW.name = lower(NEW.name);
	   INSERT INTO a VALUES(OLD.id, OLD.name);
	   RETURN NEW;
	END;
$$ LANGUAGE plpgsql;
